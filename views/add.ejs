<h1>Add Product</h1>
<div style="width: 600px;">
    <form action="/add" method="POST" enctype="multipart/form-data">
        <input type="text" name="name" placeholder="Product Name" style="width:100%;" required><br>
        <input type="number" name="price" placeholder="Price" style="width:100%;" required><br>
        <input type="file" name="image" style="width:100%;" required><br>
        <button type="submit" style="width:100%;">Save</button>
    </form>
</div>