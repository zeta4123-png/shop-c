<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>แก้ไขสินค้า</title>
</head>
<body>
    <h1>แก้ไขสินค้า: <%= product.name %></h1>
    <a href="/">กลับหน้าแรก</a>
    <hr>

    <form action="/edit/<%= product.id %>" method="POST" enctype="multipart/form-data">
        <div>
            <label>ชื่อสินค้า:</label><br>
            <input type="text" name="name" value="<%= product.name %>" required>
        </div>
        <br>
        <div>
            <label>ราคา:</label><br>
            <input type="number" name="price" value="<%= product.price %>" required>
        </div>
        <br>

        <div>
            <label>รูปภาพปัจจุบัน:</label><br>
            <% if (product.image) { %>
                <img src="/uploads/<%= product.image %>" width="150"><br>
            <% } %>
            <label>เปลี่ยนรูปภาพ (ปล่อยว่างไว้ถ้าไม่ต้องการเปลี่ยน):</label><br>
            <input type="file" name="image">
        </div>
        <br>

        <button type="submit">บันทึกการแก้ไข</button>
    </form>
</body>
</html>